<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logback configuration for Physics Factory.

  The log directory follows the workspace root: PHYSICS_FACTORY_HOME if it is set, otherwise the
  process working directory - the same default as 'physics-factory.workspace.root'. Logback creates
  the directory itself, so logging works even on the very first run before the workspace exists.

  Package log levels are driven by 'logging.level.*' in application.yaml; Spring Boot applies them to
  this configuration at startup, so levels have a single source of truth.
-->
<configuration>

    <property name="LOG_DIR" value="${PHYSICS_FACTORY_HOME:-.}/logs"/>
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/physics-factory.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/physics-factory-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
